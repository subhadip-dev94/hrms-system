<!-- Page Heading -->
<div class="d-sm-flex align-items-center justify-content-between mb-4 pt-3">
  <h1 class="h3 mb-0 text-gray-800">
    <i class="fas fa-user-circle mr-2 text-primary"></i> My Profile
  </h1>
  <a href="/auth/change-password" class="btn btn-outline-primary btn-sm shadow-sm">
    <i class="fas fa-key fa-sm mr-1"></i> Change Password
  </a>
</div>

<form action="/profile" method="POST" enctype="multipart/form-data">

  <!-- ── Overview card ──────────────────────────────────────────────────────── -->
  <div class="card shadow mb-4">
    <div class="card-body">
      <div class="d-flex align-items-center flex-wrap" style="gap:20px;">

        <!-- Avatar + upload -->
        <div class="text-center" style="min-width:120px;">
          <% if (employee.profilePhoto) { %>
            <img id="photoPreview" src="<%= employee.profilePhoto %>"
                 class="rounded-circle mb-2"
                 width="100" height="100"
                 style="object-fit:cover;border:3px solid #e3e6f0;" />
          <% } else { %>
            <img id="photoPreview"
                 src="https://ui-avatars.com/api/?name=<%= encodeURIComponent(employee.firstName + ' ' + employee.lastName) %>&background=4e73df&color=fff&size=100&bold=true"
                 class="rounded-circle mb-2" width="100" height="100" />
          <% } %>
          <div>
            <label for="profilePhotoInput" class="btn btn-outline-secondary btn-sm mb-0"
                   style="cursor:pointer;">
              <i class="fas fa-camera mr-1"></i> Change Photo
            </label>
            <input type="file" id="profilePhotoInput" name="profilePhoto"
                   accept="image/jpeg,image/jpg,image/png"
                   class="d-none" onchange="previewPhoto(this)" />
          </div>
          <small class="text-muted d-block mt-1" style="font-size:10px;">JPG/PNG · max 2 MB</small>
        </div>

        <!-- Read-only employee info -->
        <div class="flex-grow-1">
          <h4 class="font-weight-bold text-gray-800 mb-1">
            <%= employee.firstName %> <%= employee.lastName %>
          </h4>
          <div class="mb-2">
            <span class="badge badge-primary text-capitalize mr-1"><%= employee.role %></span>
            <% if (employee.status === 'active') { %>
              <span class="badge badge-success">Active</span>
            <% } else { %>
              <span class="badge badge-secondary text-capitalize"><%= employee.status %></span>
            <% } %>
          </div>
          <div class="row text-sm" style="font-size:.84rem;">
            <div class="col-sm-6 mb-1">
              <span class="text-muted">Employee Code:</span>
              <strong class="ml-1"><%= employee.employeeCode || '—' %></strong>
            </div>
            <div class="col-sm-6 mb-1">
              <span class="text-muted">Email:</span>
              <strong class="ml-1"><%= employee.email %></strong>
            </div>
            <div class="col-sm-6 mb-1">
              <span class="text-muted">Designation:</span>
              <strong class="ml-1"><%= employee.designation || '—' %></strong>
            </div>
            <div class="col-sm-6 mb-1">
              <span class="text-muted">Department:</span>
              <strong class="ml-1"><%= employee.departmentId ? employee.departmentId.name : '—' %></strong>
            </div>
            <div class="col-sm-6 mb-1">
              <span class="text-muted">Joining Date:</span>
              <strong class="ml-1"><%= employee.joiningDate ? new Date(employee.joiningDate).toLocaleDateString('en-IN', { day:'2-digit', month:'short', year:'numeric' }) : '—' %></strong>
            </div>
            <div class="col-sm-6 mb-1">
              <span class="text-muted">Manager:</span>
              <strong class="ml-1"><%= employee.managerId ? employee.managerId.firstName + ' ' + employee.managerId.lastName : '—' %></strong>
            </div>
          </div>
        </div>

      </div>
    </div>
  </div>

  <!-- ── Editable details ────────────────────────────────────────────────────── -->
  <div class="row">

    <!-- Personal details -->
    <div class="col-lg-6 mb-4">
      <div class="card shadow h-100">
        <div class="card-header py-3">
          <h6 class="m-0 font-weight-bold text-primary">
            <i class="fas fa-user mr-1"></i> Personal Details
          </h6>
        </div>
        <div class="card-body">

          <div class="form-row">
            <div class="form-group col-md-6">
              <label class="small font-weight-bold">First Name</label>
              <input type="text" class="form-control form-control-sm bg-light"
                     value="<%= employee.firstName %>" disabled />
              <small class="text-muted">Managed by HR</small>
            </div>
            <div class="form-group col-md-6">
              <label class="small font-weight-bold">Last Name</label>
              <input type="text" class="form-control form-control-sm bg-light"
                     value="<%= employee.lastName %>" disabled />
            </div>
          </div>

          <div class="form-group">
            <label class="small font-weight-bold">Email Address</label>
            <input type="email" class="form-control form-control-sm bg-light"
                   value="<%= employee.email %>" disabled />
            <small class="text-muted">Contact admin to change email</small>
          </div>

          <div class="form-row">
            <div class="form-group col-md-6">
              <label class="small font-weight-bold">Gender</label>
              <input type="text" class="form-control form-control-sm bg-light text-capitalize"
                     value="<%= employee.gender || '—' %>" disabled />
            </div>
            <div class="form-group col-md-6">
              <label class="small font-weight-bold">Date of Birth</label>
              <input type="text" class="form-control form-control-sm bg-light"
                     value="<%= employee.dateOfBirth ? new Date(employee.dateOfBirth).toLocaleDateString('en-IN', { day:'2-digit', month:'short', year:'numeric' }) : '—' %>" disabled />
            </div>
          </div>

          <div class="form-group">
            <label class="small font-weight-bold">
              Phone <span class="text-primary">(editable)</span>
            </label>
            <input type="tel" name="phone" class="form-control form-control-sm"
                   placeholder="Your contact number"
                   value="<%= employee.phone || '' %>" />
          </div>

          <div class="form-group mb-0">
            <label class="small font-weight-bold">
              Address <span class="text-primary">(editable)</span>
            </label>
            <textarea name="address" class="form-control form-control-sm" rows="3"
                      placeholder="Your residential address"><%= employee.address || '' %></textarea>
          </div>

        </div>
      </div>
    </div>

    <!-- Bank details -->
    <div class="col-lg-6 mb-4">
      <div class="card shadow h-100">
        <div class="card-header py-3 d-flex align-items-center justify-content-between">
          <h6 class="m-0 font-weight-bold text-primary">
            <i class="fas fa-university mr-1"></i> Bank Details
          </h6>
          <span class="badge badge-light border text-muted small">
            <i class="fas fa-lock mr-1"></i> Visible to HR/Admin
          </span>
        </div>
        <div class="card-body">

          <div class="alert alert-warning py-2 small mb-3">
            <i class="fas fa-exclamation-triangle mr-1"></i>
            Keep your bank details accurate for correct salary disbursement.
          </div>

          <div class="form-group">
            <label class="small font-weight-bold">Bank Name</label>
            <input type="text" name="bankName" class="form-control form-control-sm"
                   placeholder="e.g. State Bank of India"
                   value="<%= (employee.bankDetails && employee.bankDetails.bankName) ? employee.bankDetails.bankName : '' %>" />
          </div>

          <div class="form-group">
            <label class="small font-weight-bold">Account Number</label>
            <input type="text" name="accountNumber" class="form-control form-control-sm"
                   placeholder="Your bank account number"
                   value="<%= (employee.bankDetails && employee.bankDetails.accountNumber) ? employee.bankDetails.accountNumber : '' %>" />
          </div>

          <div class="form-group mb-0">
            <label class="small font-weight-bold">IFSC Code</label>
            <input type="text" name="ifscCode" class="form-control form-control-sm text-uppercase"
                   placeholder="e.g. SBIN0001234" maxlength="11"
                   value="<%= (employee.bankDetails && employee.bankDetails.ifscCode) ? employee.bankDetails.ifscCode : '' %>"
                   oninput="this.value = this.value.toUpperCase()" />
          </div>

        </div>
      </div>
    </div>

  </div>

  <!-- Save button -->
  <div class="text-right mb-4">
    <a href="/dashboard" class="btn btn-secondary mr-2">Cancel</a>
    <button type="submit" class="btn btn-primary px-4">
      <i class="fas fa-save mr-1"></i> Save Changes
    </button>
  </div>

</form>

<script>
  function previewPhoto(input) {
    if (input.files && input.files[0]) {
      var reader = new FileReader();
      reader.onload = function(e) {
        document.getElementById('photoPreview').src = e.target.result;
      };
      reader.readAsDataURL(input.files[0]);
    }
  }
</script>
