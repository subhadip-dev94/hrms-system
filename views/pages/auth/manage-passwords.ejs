<!-- Page Heading -->
<div class="d-sm-flex align-items-center justify-content-between mb-4 pt-3">
  <h1 class="h3 mb-0 text-gray-800">
    <i class="fas fa-users-cog mr-2 text-primary"></i>
    <%= requesterRole === 'hr' ? 'Employee Passwords' : 'Manage User Passwords' %>
  </h1>
  <a href="/auth/change-password" class="btn btn-outline-primary btn-sm shadow-sm">
    <i class="fas fa-key fa-sm mr-1"></i> Change My Password
  </a>
</div>

<% if (requesterRole === 'hr') { %>
<div class="alert alert-info alert-sm mb-4 py-2">
  <i class="fas fa-info-circle mr-1"></i>
  As HR, you can reset passwords for <strong>employees</strong> only. Admin passwords are managed by the system administrator.
</div>
<% } %>

<div class="card shadow mb-4">
  <div class="card-header py-3">
    <h6 class="m-0 font-weight-bold text-primary">
      <%= requesterRole === 'hr' ? 'Employee Accounts' : 'All User Accounts' %>
      <span class="badge badge-primary ml-2"><%= users.length %></span>
    </h6>
  </div>
  <div class="card-body">
    <div class="table-responsive">
      <table class="table table-bordered table-hover table-datatable" width="100%" cellspacing="0">
        <thead class="thead-light">
          <tr>
            <th>Employee</th>
            <th>Email</th>
            <th>Role</th>
            <th>Status</th>
            <th>Last Login</th>
            <th style="width:130px;">Action</th>
          </tr>
        </thead>
        <tbody>
          <% users.forEach(function(u) { %>
          <tr>
            <td>
              <% if (u.employeeId) { %>
                <div class="font-weight-bold small"><%= u.employeeId.firstName %> <%= u.employeeId.lastName %></div>
                <div class="text-muted" style="font-size:11px;"><%= u.employeeId.employeeCode %><% if (u.employeeId.designation) { %> &bull; <%= u.employeeId.designation %><% } %></div>
              <% } else { %>
                <span class="text-muted small">System Admin</span>
              <% } %>
            </td>
            <td class="small"><%= u.email %></td>
            <td>
              <span class="badge badge-<%= u.role === 'admin' ? 'danger' : u.role === 'hr' ? 'info' : u.role === 'manager' ? 'warning' : u.role === 'finance' ? 'success' : 'secondary' %> text-capitalize">
                <%= u.role %>
              </span>
            </td>
            <td>
              <% if (u.isActive) { %>
                <span class="badge badge-success">Active</span>
              <% } else { %>
                <span class="badge badge-secondary">Inactive</span>
              <% } %>
            </td>
            <td class="small text-muted">
              <%= u.lastLogin ? new Date(u.lastLogin).toLocaleDateString('en-IN', { day:'2-digit', month:'short', year:'numeric' }) : '—' %>
            </td>
            <td>
              <button class="btn btn-sm btn-outline-warning btn-reset-pw"
                      data-user-id="<%= u._id %>"
                      data-user-name="<%= u.employeeId ? u.employeeId.firstName + ' ' + u.employeeId.lastName : u.email %>">
                <i class="fas fa-key mr-1"></i> Reset
              </button>
            </td>
          </tr>
          <% }) %>
        </tbody>
      </table>
    </div>
  </div>
</div>

<!-- Reset Password Modal -->
<div class="modal fade" id="resetModal" tabindex="-1" role="dialog" aria-hidden="true">
  <div class="modal-dialog" role="document">
    <div class="modal-content">
      <form id="resetForm" method="POST" autocomplete="off">
        <div class="modal-header bg-warning text-white">
          <h5 class="modal-title"><i class="fas fa-key mr-2"></i> Reset Password</h5>
          <button type="button" class="close text-white" data-dismiss="modal"><span>&times;</span></button>
        </div>
        <div class="modal-body">
          <p class="text-muted small mb-1">
            Setting a new password for: <strong id="resetUserName"></strong>
          </p>
          <p class="text-muted small mb-3">
            <i class="fas fa-envelope mr-1"></i> The user will receive an email with their new password.
          </p>
          <div class="form-group">
            <label class="small font-weight-bold">New Password <span class="text-danger">*</span></label>
            <div class="input-group">
              <input type="password" name="newPassword" id="modalNewPw"
                class="form-control" placeholder="Min. 6 characters" required minlength="6" />
              <div class="input-group-append">
                <button type="button" class="btn btn-outline-secondary" id="toggleModalPw">
                  <i class="fas fa-eye"></i>
                </button>
              </div>
            </div>
          </div>
          <div class="form-group mb-0">
            <label class="small font-weight-bold">Confirm Password <span class="text-danger">*</span></label>
            <input type="password" name="confirmPassword" id="modalConfirmPw"
              class="form-control" placeholder="Re-enter new password" required minlength="6" />
            <small id="modalMatchMsg" class="form-text"></small>
          </div>
        </div>
        <div class="modal-footer">
          <button type="button" class="btn btn-secondary" data-dismiss="modal">Cancel</button>
          <button type="submit" class="btn btn-warning text-white">
            <i class="fas fa-save mr-1"></i> Reset Password
          </button>
        </div>
      </form>
    </div>
  </div>
</div>

<script>
  function openResetModal(userId, userName) {
    document.getElementById('resetForm').action = '/auth/manage-passwords/' + userId;
    document.getElementById('resetUserName').textContent = userName;
    document.getElementById('modalNewPw').value = '';
    document.getElementById('modalConfirmPw').value = '';
    document.getElementById('modalMatchMsg').textContent = '';
    $('#resetModal').modal('show');
  }

  document.querySelectorAll('.btn-reset-pw').forEach(function(btn) {
    btn.addEventListener('click', function() {
      openResetModal(this.dataset.userId, this.dataset.userName);
    });
  });

  document.getElementById('toggleModalPw').addEventListener('click', function() {
    var input = document.getElementById('modalNewPw');
    var icon  = this.querySelector('i');
    if (input.type === 'password') {
      input.type = 'text';
      icon.classList.replace('fa-eye', 'fa-eye-slash');
    } else {
      input.type = 'password';
      icon.classList.replace('fa-eye-slash', 'fa-eye');
    }
  });

  document.getElementById('modalConfirmPw').addEventListener('input', function() {
    var msg = document.getElementById('modalMatchMsg');
    if (this.value === document.getElementById('modalNewPw').value) {
      msg.textContent = '✓ Passwords match';
      msg.className = 'form-text text-success';
    } else {
      msg.textContent = '✗ Passwords do not match';
      msg.className = 'form-text text-danger';
    }
  });
</script>
