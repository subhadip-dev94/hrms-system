<!-- Page Heading -->
<div class="d-sm-flex align-items-center justify-content-between mb-4 pt-3">
  <h1 class="h3 mb-0 text-gray-800">
    <i class="fas fa-plus-circle mr-2 text-primary"></i> Log Work
  </h1>
  <a href="/timesheet" class="btn btn-outline-secondary btn-sm">
    <i class="fas fa-arrow-left fa-sm mr-1"></i> Back to Timesheet
  </a>
</div>

<% if (locals.errors && errors.length > 0) { %>
<div class="alert alert-danger">
  <ul class="mb-0">
    <% errors.forEach(function(e) { %><li><%= e %></li><% }) %>
  </ul>
</div>
<% } %>

<div class="row justify-content-center">
  <div class="col-lg-7">
    <div class="card shadow mb-4">
      <div class="card-header py-3">
        <h6 class="m-0 font-weight-bold text-primary">Work Entry</h6>
      </div>
      <div class="card-body">
        <form action="/timesheet" method="POST">

          <div class="row">
            <div class="col-md-6">
              <div class="form-group">
                <label>Date <span class="text-danger">*</span></label>
                <input type="date" name="date" class="form-control"
                  value="<%= locals.old ? locals.old.date : defaultDate %>"
                  max="<%= new Date().toISOString().split('T')[0] %>" required>
              </div>
            </div>
            <div class="col-md-6">
              <div class="form-group">
                <label>Hours <span class="text-danger">*</span></label>
                <input type="number" name="hours" class="form-control"
                  min="0.5" max="24" step="0.5"
                  value="<%= locals.old ? locals.old.hours : '' %>"
                  placeholder="e.g. 4.5" required>
                <small class="form-text text-muted">0.5 – 24 hours</small>
              </div>
            </div>
          </div>

          <div class="form-group">
            <label>Project Name <span class="text-danger">*</span></label>
            <input type="text" name="projectName" class="form-control"
              value="<%= locals.old ? locals.old.projectName : '' %>"
              placeholder="e.g. HRMS Portal, Internal Operations"
              maxlength="100" required>
          </div>

          <div class="form-group">
            <label>Task Description <span class="text-danger">*</span></label>
            <textarea name="taskDescription" class="form-control" rows="3"
              placeholder="Briefly describe what you worked on…"
              maxlength="500" required><%= locals.old ? locals.old.taskDescription : '' %></textarea>
            <small class="form-text text-muted">Minimum 5 characters</small>
          </div>

          <div class="form-group">
            <label>Work Type <span class="text-danger">*</span></label>
            <select name="workType" class="form-control" required>
              <option value="">— Select —</option>
              <option value="billable" <%= locals.old && locals.old.workType === 'billable' ? 'selected' : '' %>>Billable</option>
              <option value="non-billable" <%= locals.old && locals.old.workType === 'non-billable' ? 'selected' : '' %>>Non-Billable</option>
            </select>
          </div>

          <div class="alert alert-info small mb-3">
            <i class="fas fa-info-circle mr-1"></i>
            Total hours logged for a single day cannot exceed <strong>24 hours</strong>.
          </div>

          <button type="submit" class="btn btn-primary">
            <i class="fas fa-save mr-1"></i> Save Entry
          </button>
          <a href="/timesheet" class="btn btn-outline-secondary ml-2">Cancel</a>
        </form>
      </div>
    </div>
  </div>
</div>
