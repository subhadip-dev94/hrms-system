

<div class="d-sm-flex align-items-center justify-content-between mb-4">
  <h1 class="h3 mb-0 text-gray-800">Reports & Analytics</h1>
  <span class="text-muted small">Financial Year: <%= new Date().getMonth() + 1 >= 4 ? new Date().getFullYear() + '-' + String(new Date().getFullYear()+1).slice(-2) : (new Date().getFullYear()-1) + '-' + String(new Date().getFullYear()).slice(-2) %></span>
</div>

<!-- Quick filter (month/year passed via query) -->
<div class="card shadow mb-4">
  <div class="card-body py-3">
    <form method="GET" action="/reports/attendance" class="form-inline">
      <span class="mr-3 font-weight-bold text-sm">Quick Filter:</span>
      <select name="month" class="form-control form-control-sm mr-2">
        <% ['January','February','March','April','May','June','July','August','September','October','November','December'].forEach((m,i) => { %>
          <option value="<%= i+1 %>" <%= (i+1) === currentMonth ? 'selected' : '' %>><%= m %></option>
        <% }) %>
      </select>
      <input type="number" name="year" class="form-control form-control-sm mr-2" value="<%= currentYear %>" style="width:90px">
      <button type="submit" class="btn btn-primary btn-sm mr-2">Go to Attendance</button>
    </form>
  </div>
</div>

<!-- Report cards -->
<div class="row">

  <div class="col-xl-4 col-md-6 mb-4">
    <div class="card shadow h-100 border-left-primary">
      <div class="card-body">
        <div class="d-flex align-items-center mb-3">
          <div class="icon-circle bg-primary mr-3" style="width:48px;height:48px;display:flex;align-items:center;justify-content:center;border-radius:50%;">
            <i class="fas fa-calendar-check text-white fa-lg"></i>
          </div>
          <div>
            <h5 class="mb-0 font-weight-bold">Attendance Report</h5>
            <small class="text-muted">Per-employee attendance statistics</small>
          </div>
        </div>
        <p class="text-sm text-muted">Present days, absent, late arrivals, work hours, and attendance percentage by employee or department.</p>
        <div class="d-flex justify-content-between">
          <a href="/reports/attendance" class="btn btn-primary btn-sm">View Report</a>
          <a href="/reports/attendance/export" class="btn btn-outline-primary btn-sm"><i class="fas fa-download mr-1"></i>PDF</a>
        </div>
      </div>
    </div>
  </div>

  <div class="col-xl-4 col-md-6 mb-4">
    <div class="card shadow h-100 border-left-success">
      <div class="card-body">
        <div class="d-flex align-items-center mb-3">
          <div class="icon-circle bg-success mr-3" style="width:48px;height:48px;display:flex;align-items:center;justify-content:center;border-radius:50%;">
            <i class="fas fa-plane-departure text-white fa-lg"></i>
          </div>
          <div>
            <h5 class="mb-0 font-weight-bold">Leave Report</h5>
            <small class="text-muted">Leave utilisation by type and employee</small>
          </div>
        </div>
        <p class="text-sm text-muted">Casual, sick, earned leave breakdown per employee. Pending applications and leave balance summary.</p>
        <div class="d-flex justify-content-between">
          <a href="/reports/leave" class="btn btn-success btn-sm">View Report</a>
          <a href="/reports/leave/export" class="btn btn-outline-success btn-sm"><i class="fas fa-download mr-1"></i>PDF</a>
        </div>
      </div>
    </div>
  </div>

  <div class="col-xl-4 col-md-6 mb-4">
    <div class="card shadow h-100 border-left-warning">
      <div class="card-body">
        <div class="d-flex align-items-center mb-3">
          <div class="icon-circle bg-warning mr-3" style="width:48px;height:48px;display:flex;align-items:center;justify-content:center;border-radius:50%;">
            <i class="fas fa-file-invoice-dollar text-white fa-lg"></i>
          </div>
          <div>
            <h5 class="mb-0 font-weight-bold">Payroll Report</h5>
            <small class="text-muted">Monthly salary & deduction breakdown</small>
          </div>
        </div>
        <p class="text-sm text-muted">Gross pay, PF, ESI, tax, net pay per employee. Department totals and month comparison.</p>
        <div class="d-flex justify-content-between">
          <a href="/reports/payroll" class="btn btn-warning btn-sm">View Report</a>
          <a href="/reports/payroll/export" class="btn btn-outline-warning btn-sm"><i class="fas fa-download mr-1"></i>PDF</a>
        </div>
      </div>
    </div>
  </div>

  <div class="col-xl-4 col-md-6 mb-4">
    <div class="card shadow h-100 border-left-info">
      <div class="card-body">
        <div class="d-flex align-items-center mb-3">
          <div class="icon-circle bg-info mr-3" style="width:48px;height:48px;display:flex;align-items:center;justify-content:center;border-radius:50%;">
            <i class="fas fa-star text-white fa-lg"></i>
          </div>
          <div>
            <h5 class="mb-0 font-weight-bold">Performance Report</h5>
            <small class="text-muted">Review ratings and KPI completion</small>
          </div>
        </div>
        <p class="text-sm text-muted">Average ratings, performance grades, KPI completion percentages. Top performers and department ranking.</p>
        <div class="d-flex justify-content-between">
          <a href="/reports/performance" class="btn btn-info btn-sm">View Report</a>
        </div>
      </div>
    </div>
  </div>

  <div class="col-xl-4 col-md-6 mb-4">
    <div class="card shadow h-100 border-left-danger">
      <div class="card-body">
        <div class="d-flex align-items-center mb-3">
          <div class="icon-circle bg-danger mr-3" style="width:48px;height:48px;display:flex;align-items:center;justify-content:center;border-radius:50%;">
            <i class="fas fa-users text-white fa-lg"></i>
          </div>
          <div>
            <h5 class="mb-0 font-weight-bold">Headcount Report</h5>
            <small class="text-muted">Workforce size & turnover analysis</small>
          </div>
        </div>
        <p class="text-sm text-muted">Total headcount, new joinings, exits, turnover rate, gender distribution, and average tenure.</p>
        <div class="d-flex justify-content-between">
          <a href="/reports/headcount" class="btn btn-danger btn-sm">View Report</a>
          <a href="/reports/headcount/export" class="btn btn-outline-danger btn-sm"><i class="fas fa-download mr-1"></i>PDF</a>
        </div>
      </div>
    </div>
  </div>

</div>
