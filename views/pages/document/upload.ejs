

<div class="d-sm-flex align-items-center justify-content-between mb-4">
  <h1 class="h3 mb-0 text-gray-800">Upload Document</h1>
  <a href="/documents" class="btn btn-secondary btn-sm">Back</a>
</div>

<div class="card shadow mb-4">
  <div class="card-body">
    <% if (typeof errors !== 'undefined' && errors.length > 0) { %>
      <div class="alert alert-danger">
        <ul class="mb-0">
          <% errors.forEach(e => { %><li><%= e %></li><% }) %>
        </ul>
      </div>
    <% } %>

    <form method="POST" action="/documents/upload" enctype="multipart/form-data">
      <div class="row">
        <div class="col-md-6">
          <div class="form-group">
            <label>Employee <span class="text-danger">*</span></label>
            <select name="employeeId" class="form-control" required>
              <option value="">— Select Employee —</option>
              <% employees.forEach(e => { %>
                <option value="<%= e._id %>"
                  <%= (typeof old !== 'undefined' ? old.employeeId : preselectedEmployee) === String(e._id) ? 'selected' : '' %>>
                  <%= e.firstName %> <%= e.lastName %> (<%= e.employeeCode %>)
                </option>
              <% }) %>
            </select>
          </div>
        </div>
        <div class="col-md-6">
          <div class="form-group">
            <label>Document Type <span class="text-danger">*</span></label>
            <select name="documentType" class="form-control" required>
              <option value="">— Select Type —</option>
              <% documentTypes.forEach(t => { %>
                <option value="<%= t %>"
                  <%= typeof old !== 'undefined' && old.documentType === t ? 'selected' : '' %>><%= t %></option>
              <% }) %>
            </select>
          </div>
        </div>
      </div>

      <div class="row">
        <div class="col-md-8">
          <div class="form-group">
            <label>Document Title <span class="text-danger">*</span></label>
            <input type="text" name="title" class="form-control" required
              value="<%= typeof old !== 'undefined' ? old.title || '' : '' %>">
          </div>
        </div>
        <div class="col-md-4">
          <div class="form-group">
            <label>Expiry Date <small class="text-muted">(optional)</small></label>
            <input type="date" name="expiryDate" class="form-control"
              value="<%= typeof old !== 'undefined' ? old.expiryDate || '' : '' %>">
          </div>
        </div>
      </div>

      <div class="form-group">
        <label>Description <small class="text-muted">(optional)</small></label>
        <textarea name="description" class="form-control" rows="2"><%= typeof old !== 'undefined' ? old.description || '' : '' %></textarea>
      </div>

      <div class="row">
        <div class="col-md-8">
          <div class="form-group">
            <label>File <span class="text-danger">*</span> <small class="text-muted">(PDF, DOC, DOCX, JPG, PNG — max 5MB)</small></label>
            <input type="file" name="document" class="form-control-file" required accept=".pdf,.doc,.docx,.jpg,.jpeg,.png">
          </div>
        </div>
        <div class="col-md-4">
          <div class="form-group mt-4">
            <div class="custom-control custom-checkbox">
              <input type="checkbox" class="custom-control-input" id="isVisibleToEmployee"
                name="isVisibleToEmployee" value="true"
                <%= typeof old === 'undefined' || old.isVisibleToEmployee !== 'false' ? 'checked' : '' %>>
              <label class="custom-control-label" for="isVisibleToEmployee">Visible to employee</label>
            </div>
          </div>
        </div>
      </div>

      <button type="submit" class="btn btn-primary">Upload Document</button>
      <a href="/documents" class="btn btn-secondary ml-2">Cancel</a>
    </form>
  </div>
</div>
