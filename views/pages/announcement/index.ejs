

<div class="d-sm-flex align-items-center justify-content-between mb-4">
  <h1 class="h3 mb-0 text-gray-800">Announcements</h1>
  <% if (['admin','hr'].includes(user.role)) { %>
    <a href="/announcements/create" class="btn btn-primary btn-sm shadow-sm">
      <i class="fas fa-plus fa-sm text-white-50"></i> New Announcement
    </a>
  <% } %>
</div>

<% if (announcements.length === 0) { %>
  <div class="alert alert-info">No announcements at this time.</div>
<% } else { %>
  <% announcements.forEach(a => { %>
    <div class="card shadow mb-3 <%= a.isPinned ? 'border-left-warning' : 'border-left-primary' %>"
         id="announcement-<%= a._id %>">
      <div class="card-body">
        <div class="d-flex justify-content-between align-items-start">
          <div class="flex-grow-1">
            <h5 class="font-weight-bold mb-1">
              <% if (a.isPinned) { %><i class="fas fa-thumbtack text-warning mr-1" title="Pinned"></i><% } %>
              <%= a.title %>
            </h5>
            <p class="mb-1"><%= a.body %></p>
            <small class="text-muted">
              By <%= a.createdBy ? `${a.createdBy.firstName} ${a.createdBy.lastName}` : '—' %>
              &bull; <%= new Date(a.createdAt).toLocaleDateString('en-IN') %>
              &bull; Targets:
              <% (a.targetRoles || []).forEach(r => { %>
                <span class="badge badge-secondary"><%= r %></span>
              <% }) %>
              <% if (a.expiresAt) { %>
                &bull; Expires: <%= new Date(a.expiresAt).toLocaleDateString('en-IN') %>
              <% } %>
            </small>
          </div>
          <div class="ml-3 d-flex flex-column align-items-end">
            <button class="btn btn-sm btn-outline-secondary mb-1 mark-read-btn"
              data-id="<%= a._id %>"
              onclick="markRead('<%= a._id %>', this)">
              Mark Read
            </button>
            <% if (isAdmin) { %>
              <form method="POST" action="/announcements/<%= a._id %>/pin" class="mb-1">
                <button type="submit" class="btn btn-sm btn-outline-warning">
                  <%= a.isPinned ? 'Unpin' : 'Pin' %>
                </button>
              </form>
              <form method="POST" action="/announcements/<%= a._id %>?_method=DELETE"
                onsubmit="return confirm('Delete this announcement?')">
                <button type="submit" class="btn btn-sm btn-outline-danger">Delete</button>
              </form>
            <% } %>
          </div>
        </div>
      </div>
    </div>
  <% }) %>
<% } %>

<script>
function markRead(id, btn) {
  fetch('/announcements/' + id + '/read', { method: 'POST' })
    .then(r => r.json())
    .then(data => {
      if (data.ok) {
        btn.textContent = 'Read';
        btn.disabled = true;
        btn.classList.remove('btn-outline-secondary');
        btn.classList.add('btn-outline-success');
      }
    })
    .catch(() => {});
}
</script>
