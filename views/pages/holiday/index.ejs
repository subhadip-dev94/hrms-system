<!-- Page Heading -->
<div class="d-sm-flex align-items-center justify-content-between mb-4 pt-3">
  <h1 class="h3 mb-0 text-gray-800">
    <i class="fas fa-calendar-alt mr-2 text-primary"></i> Holiday Calendar
  </h1>
  <% if (currentUser && ['admin','hr'].includes(currentUser.role)) { %>
  <a href="/holidays/create" class="btn btn-primary btn-sm shadow-sm">
    <i class="fas fa-plus fa-sm mr-1"></i> Add Holiday
  </a>
  <% } %>
</div>

<!-- Year Filter -->
<div class="card shadow mb-4">
  <div class="card-body py-3">
    <form method="GET" action="/holidays" class="form-inline">
      <label class="mr-2 font-weight-bold text-gray-600">Filter by Year:</label>
      <select name="year" class="form-control form-control-sm mr-2" onchange="this.form.submit()">
        <% availableYears.forEach(function(y) { %>
          <option value="<%= y %>" <%= y === selectedYear ? 'selected' : '' %>><%= y %></option>
        <% }) %>
      </select>
      <span class="text-muted small ml-2">
        <i class="fas fa-info-circle mr-1"></i>
        <%= holidays.length %> holiday(s) in <%= selectedYear %>
      </span>
    </form>
  </div>
</div>

<!-- Holidays Table -->
<div class="card shadow mb-4">
  <div class="card-header py-3">
    <h6 class="m-0 font-weight-bold text-primary">
      <i class="fas fa-umbrella-beach mr-1"></i> Holidays — <%= selectedYear %>
    </h6>
  </div>
  <div class="card-body">
    <div class="table-responsive">
      <table class="table table-bordered table-hover" width="100%" cellspacing="0">
        <thead class="thead-light">
          <tr>
            <th style="width:50px;">#</th>
            <th>Holiday Name</th>
            <th>Date</th>
            <th>Day</th>
            <th>Type</th>
            <th>Description</th>
            <% if (currentUser && ['admin','hr'].includes(currentUser.role)) { %>
            <th style="width:80px;" class="text-center">Action</th>
            <% } %>
          </tr>
        </thead>
        <tbody>
          <% if (holidays && holidays.length > 0) { %>
            <% const days = ['Sunday','Monday','Tuesday','Wednesday','Thursday','Friday','Saturday']; %>
            <% holidays.forEach(function(h, i) { %>
            <tr>
              <td class="text-muted small"><%= i + 1 %></td>
              <td class="font-weight-bold"><%= h.name %></td>
              <td>
                <i class="fas fa-calendar-day fa-xs mr-1 text-primary"></i>
                <%= new Date(h.date).toLocaleDateString('en-IN', { day:'2-digit', month:'short', year:'numeric' }) %>
              </td>
              <td>
                <% const dayIdx = new Date(h.date).getDay(); %>
                <span class="badge <%= dayIdx === 0 || dayIdx === 6 ? 'badge-danger' : 'badge-light border' %>">
                  <%= days[dayIdx] %>
                </span>
              </td>
              <td>
                <% if (h.type === 'public') { %>
                  <span class="badge badge-success px-2">Public</span>
                <% } else { %>
                  <span class="badge badge-warning px-2">Optional</span>
                <% } %>
              </td>
              <td class="small text-muted"><%= h.description || '—' %></td>
              <% if (currentUser && ['admin','hr'].includes(currentUser.role)) { %>
              <td class="text-center">
                <form action="/holidays/<%= h._id %>?_method=DELETE" method="POST"
                      style="display:inline;"
                      onsubmit="return confirm('Delete holiday \'<%= h.name %>\'?')">
                  <button type="submit" class="btn btn-sm btn-danger btn-icon" title="Delete">
                    <i class="fas fa-trash-alt"></i>
                  </button>
                </form>
              </td>
              <% } %>
            </tr>
            <% }) %>
          <% } else { %>
            <tr>
              <td colspan="7" class="text-center py-5 text-muted">
                <i class="fas fa-calendar-times fa-3x d-block mb-3 text-gray-300"></i>
                <strong>No holidays found for <%= selectedYear %></strong>
                <% if (currentUser && ['admin','hr'].includes(currentUser.role)) { %>
                  <br /><a href="/holidays/create" class="small">Add a holiday</a>
                <% } %>
              </td>
            </tr>
          <% } %>
        </tbody>
      </table>
    </div>
  </div>
</div>
